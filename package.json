{
  "name": "orbitx-bot",
  "version": "2.0.1",
  "description": "TypeScript library to program bots for the ORBITX SOCIAL chat (ORBITX SPACE). Librería TypeScript para programar bots del chat ORBITX SOCIAL.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "README.es.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "keywords": [
    "orbitx",
    "orbitx-social",
    "bot",
    "chatbot",
    "bot-framework",
    "typescript",
    "polling"
  ],
  "homepage": "https://ctrl.orbitxspace.com/bots?tab=docs",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
